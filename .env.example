# OpenAI 兼容接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4.1-mini

# 抓取最近多少小时的新闻
HOURS_BACK=48

# 候选新闻和最终条数
MAX_ARTICLES=40
TOP_N=5

# 输出目录
OUTPUT_DIR=./output

# 可选：通用 Webhook 地址
WEBHOOK_URL=

# 可选：Notion 推送（简报自动创建子页面）
# 获取方式：https://www.notion.so/profile/integrations → New integration → 复制 Secret
NOTION_TOKEN=
# 主页面 ID：从 Notion 页面 URL 中获取（32位字符串）
NOTION_PAGE_ID=

# 可选：自定义 RSS
# RSS_FEEDS_JSON=[{"name":"Example","url":"https://example.com/rss","weight":5}]

# HTTP 请求设置
REQUEST_TIMEOUT=20
REQUEST_DELAY=2.0
# HTTP_USER_AGENT=自定义 User-Agent

LOG_LEVEL=INFO
